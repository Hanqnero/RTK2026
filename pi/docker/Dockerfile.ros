# syntax=docker/dockerfile:1.7

# Тот же официальный ARM64-образ, что и в docker/Dockerfile.sim, но без
# Gazebo, noVNC и лишних desktop-инструментов: симуляция здесь не нужна.
#
# Что запускается из этого образа:
#   arduino_launch.py - привод;
#   lidar_launch.py   - RPLIDAR C1 (или запасной A1M8);
#   real_slam.py      - полный стек картографирования.
#
# Обычно RViz живёт на ноутбуке и получает топики через DDS Router,
# но образ поддерживает и локальный ``use_rviz:=true`` через X11-дисплей
# Raspberry Pi. Это полезно для стенда, а в штатном сценарии лучше
# не тратить ресурсы Pi на визуализацию.
FROM ros:jazzy-ros-base-noble AS ros_system

ARG DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN rm -f /etc/apt/apt.conf.d/docker-clean


FROM ros_system AS ros_build_tools

ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    python3-colcon-common-extensions \
    python3-rosdep \
    \
    # pyserial для rtk2026_driver.
    python3-serial


# Стек картографирования и описания робота.
#
# Отдельным слоем от инструментов сборки: меняется он редко, а слой
# тяжёлый, и пересобирать его при каждой правке кода незачем.
FROM ros_build_tools AS ros_slam

ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    \
    # 2D lidar SLAM и слияние одометрии с IMU.
    ros-jazzy-slam-toolbox \
    ros-jazzy-robot-localization \
    \
    # Опциональный локальный GUI для real_slam.py/use_rviz.
    ros-jazzy-rviz2 \
    \
    # Программный OpenGL: /dev/dri в compose намеренно не обязателен.
    libgl1-mesa-dri \
    libglx-mesa0 \
    \
    # Описание робота: TF из URDF и раскрытие xacro.
    ros-jazzy-robot-state-publisher \
    ros-jazzy-xacro \
    \
    # Работа с TF из командной строки: без неё нечем проверить дерево
    # фреймов на самом роботе, а через DDS Router граф не проходит.
    ros-jazzy-tf2-ros \
    ros-jazzy-tf2-tools \
    \
    # Диагностика: rtk2026_observability публикует DiagnosticArray и
    # опирается на diagnostic_updater.
    ros-jazzy-diagnostics \
    ros-jazzy-diagnostic-updater \
    \
    # Запись прогонов в MCAP: разбирать поведение на роботе удобнее
    # по логу, чем по картинке в RViz через сеть.
    ros-jazzy-rosbag2-storage-mcap


# Драйвер лидара. Собирается из зафиксированного Git-подмодуля:
# в apt-репозиториях ROS 2 его нет, и rosdep о нём не знает - именно
# поэтому он стоит в skip-keys ниже и в docker/Dockerfile.sim.
#
# Живёт в отдельном vendor underlay, а не в robot_ws/src.
FROM ros_slam AS lidar_driver

# Подмодуль зафиксирован в репозитории на проверенный commit с
# поддержкой RPLIDAR C1. Сборка образа не ходит в GitHub и получает
# те же исходники на Pi и на машине разработчика.
COPY vendor/sllidar_ros2/ /opt/vendor_ws/src/sllidar_ros2/

# Драйвер собирается без правок.
#
# Здесь был патч, переводивший запуск на legacy-сканирование: казалось, что
# прошивка не поддерживает перечисление режимов, потому что "Can not start
# scan" повторялся. Проверка сырым протоколом это опровергла - GET_LIDAR_CONF
# отвечает и сообщает о пяти доступных режимах.
#
# Настоящая причина была в нестабильном канале: запуск express - цепочка из
# четырёх обменов, и при 75 % успеха на шаг она проходит лишь в трети
# случаев. Патч резал разрешение вчетверо, лечив симптом, а не причину.
RUN source /opt/ros/jazzy/setup.bash && \
    cd /opt/vendor_ws && \
    colcon build --merge-install --packages-select sllidar_ros2 && \
    source /opt/vendor_ws/install/setup.bash && \
    ros2 pkg prefix sllidar_ros2 && \
    rm -rf /opt/vendor_ws/build /opt/vendor_ws/log


FROM lidar_driver AS robot_workspace

WORKDIR /workspaces/robot_ws

# Старые runtime-пути к картам и записям остаются рабочими.
RUN ln -s /workspaces/robot_ws /workspace

RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then \
        rosdep init; \
    fi && \
    \
    rosdep_updated=0 && \
    for attempt in 1 2 3; do \
        if rosdep update --rosdistro jazzy; then \
            rosdep_updated=1; \
            break; \
        fi; \
        echo "rosdep update: попытка ${attempt} завершилась ошибкой" >&2; \
        sleep $((attempt * 5)); \
    done && \
    test "${rosdep_updated}" = "1"


# Зависимости ставятся по package.xml, без исходного кода: слой
# пересобирается только при изменении состава зависимостей, а не после
# каждой правки.
#
# Копируются ровно те пакеты, которые собираются ниже. Остальной workspace
# на робота не приезжает: симуляция, зрение и навигация здесь не нужны,
# а их package.xml тянули бы Gazebo, OpenCV и Nav2 в образ.
COPY src/rtk2026_driver/package.xml \
    /tmp/rosdep/src/rtk2026_driver/package.xml
COPY src/rtk2026_description/package.xml \
    /tmp/rosdep/src/rtk2026_description/package.xml
COPY src/rtk2026_localization/package.xml \
    /tmp/rosdep/src/rtk2026_localization/package.xml
COPY src/rtk2026_slam/package.xml \
    /tmp/rosdep/src/rtk2026_slam/package.xml
COPY src/rtk2026_observability/package.xml \
    /tmp/rosdep/src/rtk2026_observability/package.xml
COPY src/rtk2026_bringup/package.xml \
    /tmp/rosdep/src/rtk2026_bringup/package.xml
COPY src/rtk2026_interfaces/package.xml \
    /tmp/rosdep/src/rtk2026_interfaces/package.xml

# Что и почему пропускается.
#
# sllidar_ros2
#     В apt его нет, он собран из исходников в /opt/vendor_ws выше.
#
# RTAB-Map
#     Зависимости остались от визуального SLAM, который на роботе не
#     запускается. Даже один rtabmap_slam тянет весь RTAB-Map, OpenCV и PCL.
#
# plotjuggler_ros, rqt_runtime_monitor, rqt_robot_monitor
#     Графические инструменты. На роботе нет дисплея, а смотреть
#     диагностику надо с ноутбука; тянут за собой Qt.
#
# rtk2026_tracked_sim
#     Единственная межпакетная зависимость, которую нечем удовлетворить:
#     rtk2026_bringup объявляет её ради sim_slam_launch.py. На роботе этот
#     сценарий не запускается, а сам пакет сюда не копируется.
#
# ros2_control, Gazebo integration и rtabmap_launch
#     Нужны только sim-URDF и sim/visual launch-файлам. Аппаратные
#     full.launch.py и real_slam.py их не запускают; без этих skip-keys rosdep
#     затягивает в Pi-образ весь Gazebo.
#
# nav2_msgs намеренно НЕ пропущен: его импортирует localization_monitor.py
# ради ParticleCloud, и это пакет сообщений, а не весь Nav2.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get -o Acquire::Retries=3 update && \
    rosdep install \
        --from-paths /tmp/rosdep/src \
        --ignore-src \
        --rosdistro jazzy \
        --skip-keys="sllidar_ros2 ament_python rtabmap_msgs rtabmap_launch \
                     rtabmap_slam rtabmap_sync \
                     plotjuggler_ros rqt_runtime_monitor rqt_robot_monitor \
                     rtk2026_tracked_sim ros2_control ros2_controllers \
                     controller_manager diff_drive_controller \
                     joint_state_broadcaster ros_gz_bridge ros_gz_sim \
                     gz_ros2_control" \
        -r \
        -y && \
    rm -rf /tmp/rosdep


# Пакеты, нужные реальному роботу.
#
# Исходники не входят в образ. Compose собирает robot_ws из bind mounts,
# а startup-скрипт запускает colcon build до открытия Bash.
#
# Рекомендуемая команда сборки приведена в docs/pi/index.rst.

# USB-камера и инструменты для работы внутри контейнера.
#
# Слой идёт после rosdep: правка списка утилит не повторяет
# разрешение зависимостей. Colcon-сборка живёт в примонтированном
# workspace и от слоёв образа не зависит.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    \
    # Драйвер USB-камеры через V4L2, публикует sensor_msgs/Image.
    ros-jazzy-v4l2-camera \
    \
    # Сжатый транспорт. Без него сырой кадр 640x480 весит около 900 КБ,
    # и на 30 кадрах это 27 МБ/с - столько по мосту до ноутбука не уйдёт.
    # С compressed тот же поток укладывается в единицы мегабит.
    ros-jazzy-image-transport-plugins \
    \
    # Запись топиков в bag: ею сохраняется видеопоток.
    ros-jazzy-rosbag2 \
    ros-jazzy-rosbag2-storage-mcap \
    \
    # Утилиты V4L2: посмотреть, какие режимы отдаёт камера.
    v4l-utils \
    \
    # Интерактивная диагностика и правка конфигов на роботе.
    tmux \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Порядок подключения важен: underlay с драйвером лидара идёт до overlay
# рабочего пространства, иначе lidar_launch.py не найдёт sllidar_ros2.
RUN printf '%s\n' \
    'set +u' \
    'source /opt/ros/jazzy/setup.bash' \
    'source /opt/vendor_ws/install/setup.bash' \
    '[ ! -f /workspaces/robot_ws/install/setup.bash ] || source /workspaces/robot_ws/install/setup.bash' \
    'set -u' \
    >> /root/.bashrc

RUN install -d -m 700 /tmp/runtime-root

COPY --chmod=755 pi/docker/start_robot_workspace.sh /usr/local/bin/start_robot_workspace

# Собираем примонтированный workspace, подключаем overlay и затем
# остаёмся в Bash для ручного запуска launch-файлов.
CMD ["/usr/local/bin/start_robot_workspace"]
