FROM arm64v8/ros:jazzy

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions \
    git \
    ros-jazzy-nav2-common \
    ros-jazzy-nav2-costmap-2d \
    ros-jazzy-nav2-lifecycle-manager \
    ros-jazzy-nav2-map-server \
    ros-jazzy-nav2-route \
    ros-jazzy-nav2-controller \
    ros-jazzy-nav2-planner \
    ros-jazzy-nav2-bt-navigator \
    ros-jazzy-nav2-behaviors \
    ros-jazzy-nav-2d-msgs \
    ros-jazzy-nav-2d-utils \
    ros-jazzy-nav2-navfn-planner \
    ros-jazzy-nav2-dwb-controller \
    ros-jazzy-nav2-regulated-pure-pursuit-controller \
    ros-jazzy-nav2-rviz-plugins \
    ros-jazzy-vision-msgs \
    ros-jazzy-rviz2 \
    ros-jazzy-bondcpp \
    ros-jazzy-geographic-msgs \
    libgraphicsmagick++1-dev \
    uuid-dev \
    xvfb \
    x11vnc \
    fluxbox \
    novnc \
    websockify \
    && if [ ! -e /opt/ros/jazzy/include/nav_2d_msgs/msg ]; then \
         ln -s /opt/ros/jazzy/include/nav_2d_msgs/nav_2d_msgs/msg /opt/ros/jazzy/include/nav_2d_msgs/msg; \
       fi \
    && rm -rf /var/lib/apt/lists/*

ENV LIBGL_ALWAYS_SOFTWARE=1

WORKDIR /workspace
COPY docker/scripts /scripts
RUN chmod +x /scripts/*.sh

RUN git clone https://github.com/ros-navigation/navigation2.git /tmp/navigation2 && \
    cd /tmp/navigation2 && \
    git checkout 51e31256055b0e8952f1920c8f4e37391ef685ec && \
    mkdir -p /workspace/src/nav2_overlay && \
    for pkg in \
      nav2_common \
      nav2_msgs \
      nav2_ros_common \
      nav2_util \
      nav2_behavior_tree \
      nav2_core \
      nav2_voxel_grid \
      nav2_costmap_2d \
      nav2_map_server \
      nav2_lifecycle_manager \
      nav2_planner \
      nav2_controller \
      nav2_bt_navigator \
      nav2_behaviors \
      nav2_route \
      nav2_navfn_planner \
      nav2_regulated_pure_pursuit_controller \
      nav2_dwb_controller \
    ; do \
      cp -R "/tmp/navigation2/${pkg}" /workspace/src/nav2_overlay/; \
    done && \
    rm -rf /tmp/navigation2

RUN python3 - <<'PY'
from pathlib import Path

path = Path("/workspace/src/nav2_overlay/nav2_dwb_controller/dwb_core/src/publisher.cpp")
text = path.read_text()
text = text.replace('#include "nav_2d_utils/conversions.hpp"\n', "")
old = """  auto path =\n    std::make_unique<nav_msgs::msg::Path>(\n    nav_2d_utils::posesToPath(\n      traj.poses, header.frame_id,\n      header.stamp));\n"""
new = """  auto path = std::make_unique<nav_msgs::msg::Path>();\n  path->header = header;\n  path->poses.reserve(traj.poses.size());\n  for (const auto & pose : traj.poses) {\n    geometry_msgs::msg::PoseStamped stamped_pose;\n    stamped_pose.header = header;\n    stamped_pose.pose = pose;\n    path->poses.push_back(std::move(stamped_pose));\n  }\n"""
if old not in text:
    raise SystemExit("publisher.cpp patch target not found")
path.write_text(text.replace(old, new))

helper = """
namespace {

nav_msgs::msg::Path adjustPlanResolutionCompat(
  const nav_msgs::msg::Path & global_plan_in,
  double resolution)
{
  nav_msgs::msg::Path global_plan_out;
  if (global_plan_in.poses.empty()) {
    return global_plan_out;
  }

  geometry_msgs::msg::PoseStamped last = global_plan_in.poses[0];
  global_plan_out.poses.push_back(last);

  const double min_sq_resolution = resolution * resolution * 4.0;

  for (unsigned int i = 1; i < global_plan_in.poses.size(); ++i) {
    const auto & loop = global_plan_in.poses[i];
    const double sq_dist =
      (loop.pose.position.x - last.pose.position.x) *
      (loop.pose.position.x - last.pose.position.x) +
      (loop.pose.position.y - last.pose.position.y) *
      (loop.pose.position.y - last.pose.position.y);

    if (sq_dist > min_sq_resolution) {
      const double diff = std::sqrt(sq_dist) - std::sqrt(min_sq_resolution);
      const int steps = static_cast<int>(diff / resolution) - 1;
      const double steps_double = static_cast<double>(steps);

      if (steps > 1 && steps_double != 0.0) {
        const double theta_last = tf2::getYaw(last.pose.orientation);
        const double theta_loop = tf2::getYaw(loop.pose.orientation);
        const double delta_x = (loop.pose.position.x - last.pose.position.x) / steps_double;
        const double delta_y = (loop.pose.position.y - last.pose.position.y) / steps_double;
        const double delta_t = (theta_loop - theta_last) / steps_double;

        for (int j = 1; j < steps; ++j) {
          geometry_msgs::msg::PoseStamped pose;
          pose.header = loop.header;
          pose.pose.position.x = last.pose.position.x + j * delta_x;
          pose.pose.position.y = last.pose.position.y + j * delta_y;
          pose.pose.orientation = nav2_util::geometry_utils::orientationAroundZAxis(
            theta_last + j * delta_t);
          global_plan_out.poses.push_back(std::move(pose));
        }
      }
    }

    global_plan_out.poses.push_back(loop);
    last = loop;
  }

  global_plan_out.header = global_plan_in.header;
  return global_plan_out;
}

}  // namespace

"""

for rel in [
    "path_dist.cpp",
    "goal_dist.cpp",
]:
    critic = Path("/workspace/src/nav2_overlay/nav2_dwb_controller/dwb_critics/src") / rel
    text = critic.read_text()
    text = text.replace('#include "nav_2d_utils/path_ops.hpp"\n', '#include <cmath>\n#include "tf2/utils.hpp"\n#include "nav2_util/geometry_utils.hpp"\n')
    text = text.replace('namespace dwb_critics\n{\n', helper + 'namespace dwb_critics\n{\n', 1)
    text = text.replace('nav_2d_utils::adjustPlanResolution(', 'adjustPlanResolutionCompat(')
    critic.write_text(text)
PY

COPY src /workspace/src
RUN . /opt/ros/jazzy/setup.sh && \
    export CMAKE_BUILD_PARALLEL_LEVEL=1 MAKEFLAGS=-j1 && \
    colcon build --symlink-install \
      --executor sequential \
      --cmake-args -DBUILD_TESTING=OFF
