# syntax=docker/dockerfile:1.7

# Нативный ARM64-образ ROS 2 Jazzy подходит как для Apple Silicon,
# так и для 64-битной Raspberry Pi.
#
# В отличие от osrf/ros:jazzy-desktop-full,
# официальный ros:jazzy-ros-base-noble имеет ARM64-вариант.
FROM ros:jazzy-ros-base-noble AS ros_system

ARG DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Стандартный docker-clean удаляет скачанные deb сразу после apt.
# Для BuildKit cache mount отключаем только эту очистку; кэш всё равно
# хранится вне итогового image и может переиспользоваться следующей сборкой.
RUN rm -f /etc/apt/apt.conf.d/docker-clean


# Версии пакетов ROS не фиксируются: берутся те, что в репозитории на день
# сборки.
#
# Снимок snapshots.ros.org не годится. Он подписан отдельным ключом «ROS
# Snapshot builder», которого в базовом образе нет и который к тому же
# регулярно истекает; https домен не отдаёт — сертификат CloudFront его не
# покрывает. Остались бы либо тяга ключа с keyserver, либо trusted=yes,
# то есть выключенная проверка подписи. Ни то, ни другое не стоит
# воспроизводимости сборки.
#
# Если она понадобится, дешёвый способ без лишних частей — прибить базовый
# образ по digest:
#     FROM ros:jazzy-ros-base-noble@sha256:...
# Это фиксирует всё, что пришло с ним; версии, доставленные слоями ниже,
# останутся на день сборки. Какие именно оказались в образе, видно так:
#     dpkg -l 'ros-jazzy-*'


# GUI и инструменты сборки. Раньше здесь стоял ros-jazzy-desktop-full, то
# есть desktop + perception + simulation: метапакет тащил ровно то, что
# стадии ниже ставят адресно, и обесценивал стадийность.
FROM ros_system AS ros_gui

ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    \
    # Визуализация карты, графа, костмап и пути.
    ros-jazzy-rviz2 \
    \
    # Описание робота: TF из URDF и раскрытие xacro.
    ros-jazzy-robot-state-publisher \
    ros-jazzy-joint-state-publisher \
    ros-jazzy-xacro \
    \
    # Работа с TF из командной строки: нужна tf_time_monitor и разбору TF.
    ros-jazzy-tf2-ros \
    ros-jazzy-tf2-tools \
    \
    # Клавиатурное управление через /cmd_vel.
    ros-jazzy-teleop-twist-keyboard \
    \
    # Сборка пакетов рабочего пространства.
    build-essential \
    cmake \
    python3-colcon-common-extensions \
    python3-rosdep \
    \
    # pyserial для rtk2026_driver.
    python3-serial \
    \
    # Виртуальный X11-сервер и передача экрана в браузер.
    xvfb \
    x11vnc \
    novnc \
    websockify \
    fluxbox \
    x11-utils \
    \
    # Программный OpenGL через Mesa.
    libgl1-mesa-dri \
    libglx-mesa0 \
    mesa-utils \
    \
    # D-Bus для Linux GUI-приложений.
    dbus-x11


# Симуляция. Отдельно от GUI: Gazebo меняется реже RViz-инструментов
# и заметно тяжелее.
FROM ros_gui AS ros_sim

ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    \
    # Интеграция ROS 2 с современным Gazebo.
    ros-jazzy-ros-gz \
    \
    # Подключение ros2_control к Gazebo.
    ros-jazzy-gz-ros2-control \
    \
    # diff_drive_controller, joint_state_broadcaster и другие.
    ros-jazzy-ros2-controllers


# Навигация: стек, по которому едет робот, плюс построение карты.
FROM ros_sim AS ros_navigation

ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    \
    # 2D lidar SLAM и EKF odometry.
    ros-jazzy-slam-toolbox \
    ros-jazzy-robot-localization \
    \
    # Полный Nav2: planner, controller, BT, behaviors, costmap filters
    # и map_server. Внимание: vector_object_server сюда НЕ входит - в
    # Jazzy (1.3.12) его нет, он появился только в Nav2 main (1.5.0).
    # Его добавляет слой vo_backport ниже.
    ros-jazzy-navigation2 \
    ros-jazzy-nav2-bringup \
    \
    # Route Server: чтение графа из GeoJSON.
    ros-jazzy-nav2-route \
    \
    # Панели RViz Nav2, среди них Route Tool — редактор графа.
    ros-jazzy-nav2-rviz-plugins


# Vector Object Server: backport в Jazzy.
#
# Запретные зоны размечаются кликами в RViz (rtk2026_vector_objects,
# keepout_click_tool), а тот работает через nav2_msgs/AddShapes и
# vector_object_server. Ни того, ни другого в Jazzy нет: интерфейсы и сервер
# появились только в Nav2 main. Ветку целиком взять нельзя - подробности и
# причины в самом скрипте.
#
# Отдельным слоем и до сборки workspace: меняется он практически никогда,
# а собирается несколько минут.
FROM ros_navigation AS vo_backport

ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    libgraphicsmagick++-dev \
    ros-jazzy-nav2-common

COPY --chmod=755 docker/vo_backport.sh /usr/local/bin/vo_backport

RUN /usr/local/bin/vo_backport

# Порядок сорсинга обязателен: backport перекрывает nav2_msgs и
# nav2_map_server из apt, поэтому идёт после /opt/ros/jazzy и до workspace.


# Perception и диагностика: меняются чаще навигации.
FROM vo_backport AS ros_perception

ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    \
    # RGB-D visual SLAM.
    ros-jazzy-rtabmap-ros \
    \
    # ROS/OpenCV bridge и типы компьютерного зрения. python3-opencv
    # и python3-numpy приходят с cv-bridge; названы явно, потому что
    # rtk2026_cv импортирует их напрямую.
    ros-jazzy-cv-bridge \
    ros-jazzy-image-transport \
    ros-jazzy-image-view \
    ros-jazzy-vision-msgs \
    python3-opencv \
    python3-numpy \
    python3-yaml \
    \
    # Диагностика: агрегатор, публикация статусов и просмотр.
    # diagnostic-updater назван явно: его импортируют и мониторы
    # observability, и нода движения по городу.
    ros-jazzy-diagnostics \
    ros-jazzy-diagnostic-updater \
    ros-jazzy-rqt-runtime-monitor \
    ros-jazzy-rqt-robot-monitor \
    ros-jazzy-plotjuggler-ros \
    \
    # Запись воспроизводимых экспериментов в MCAP.
    ros-jazzy-rosbag2-storage-mcap


# Финальная стадия: зависимости пакетов и сборка кода RTK2026.
FROM ros_perception AS sim_workspace

# Виртуальный X11-дисплей.
ENV DISPLAY=:1

# Отдельный X11-дисплей для PlotJuggler и RQt, второй noVNC на 6081.
ENV DIAGNOSTICS_DISPLAY=:2

ENV QT_X11_NO_MITSHM=1

# Программный OpenGL: наиболее предсказуемый вариант для контейнера
# внутри Docker Desktop на macOS.
ENV LIBGL_ALWAYS_SOFTWARE=1

ENV XDG_RUNTIME_DIR=/tmp/runtime-root

WORKDIR /workspace


# Обновление базы rosdep не зависит от исходного кода проекта. Выносим его
# до COPY, чтобы правка кода не сбрасывала этот сетевой шаг. Повторы
# защищают первую сборку от временных SSL timeout.
RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then \
        rosdep init; \
    fi && \
    \
    rosdep_updated=0 && \
    for attempt in 1 2 3; do \
        if rosdep update --rosdistro jazzy; then \
            rosdep_updated=1; \
            break; \
        fi; \
        echo "rosdep update: попытка ${attempt} завершилась ошибкой" >&2; \
        sleep $((attempt * 5)); \
    done && \
    test "${rosdep_updated}" = "1"


# Для установки зависимостей достаточно package.xml. Слой пересобирается
# только при изменении состава зависимостей, а не после каждой правки кода.
#
# Список ведётся руками намеренно: COPY по маске уравнял бы этот слой
# с копированием всего src и лишил бы смысла.
COPY src/rtk2026_interfaces/package.xml \
    /tmp/rosdep/src/rtk2026_interfaces/package.xml
COPY src/rtk2026_pose_graph/package.xml \
    /tmp/rosdep/src/rtk2026_pose_graph/package.xml
COPY src/rtk2026_city_nav/package.xml \
    /tmp/rosdep/src/rtk2026_city_nav/package.xml
COPY src/rtk2026_nav2/package.xml \
    /tmp/rosdep/src/rtk2026_nav2/package.xml
COPY src/rtk2026_vector_objects/package.xml \
    /tmp/rosdep/src/rtk2026_vector_objects/package.xml
COPY src/rtk2026_description/package.xml \
    /tmp/rosdep/src/rtk2026_description/package.xml
COPY src/rtk2026_driver/package.xml \
    /tmp/rosdep/src/rtk2026_driver/package.xml
COPY src/rtk2026_slam/package.xml \
    /tmp/rosdep/src/rtk2026_slam/package.xml
COPY src/rtk2026_localization/package.xml \
    /tmp/rosdep/src/rtk2026_localization/package.xml
COPY src/rtk2026_observability/package.xml \
    /tmp/rosdep/src/rtk2026_observability/package.xml
COPY src/rtk2026_tracked_sim/package.xml \
    /tmp/rosdep/src/rtk2026_tracked_sim/package.xml
COPY src/rtk2026_cv/package.xml \
    /tmp/rosdep/src/rtk2026_cv/package.xml
COPY src/rtk2026_bringup/package.xml \
    /tmp/rosdep/src/rtk2026_bringup/package.xml

# rtk2026_interfaces из skip-keys убран: он лежит в этом же рабочем
# пространстве, и rosdep находит его сам. В skip-keys он маскировал бы то,
# что пакет не собирается, а именно это и ломало rtk2026_cv раньше.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get -o Acquire::Retries=3 update && \
    rosdep install \
        --from-paths /tmp/rosdep/src \
        --ignore-src \
        --rosdistro jazzy \
        --skip-keys="sllidar_ros2 ament_python" \
        -r \
        -y && \
    rm -rf /tmp/rosdep


# Исходники. Build context в compose равен корню проекта.
COPY src/ /workspace/src/

# Карты нужны Map Server. YAML хранит относительное имя PGM, поэтому
# копируется весь каталог.
COPY maps/ /workspace/maps/

# Gazebo worlds передаются лаунчу абсолютным путём.
COPY worlds/ /workspace/worlds/


# Собираются все пакеты, нужные движению по городу в симуляции.
#
# rtk2026_interfaces обязателен: без него нет типа DrivingDetection, и
# rtk2026_cv с rtk2026_city_nav падают на импорте. Раньше его в списке
# не было, хотя rtk2026_cv от него зависит.
#
# rtk2026_route_nav и rtk2026_graph собираются не ради навигации - её
# заменили rtk2026_city_nav и rtk2026_nav2 - а ради единственного
# сценария: route_tool_with_costmap.launch.py, офлайн-режим правки
# костмапы и запретных зон над готовой картой. rtk2026_graph тянется
# как зависимость rtk2026_route_nav.
RUN source /opt/ros/jazzy/setup.bash && \
    source /opt/vo_ws/install/setup.bash && \
    colcon build \
        --symlink-install \
        --packages-select \
            rtk2026_interfaces \
            rtk2026_pose_graph \
            rtk2026_graph \
            rtk2026_route_nav \
            rtk2026_city_nav \
            rtk2026_nav2 \
            rtk2026_vector_objects \
            rtk2026_description \
            rtk2026_driver \
            rtk2026_slam \
            rtk2026_localization \
            rtk2026_observability \
            rtk2026_tracked_sim \
            rtk2026_cv \
            rtk2026_bringup

COPY --chmod=755 \
    docker/start_sim_novnc.sh \
    /usr/local/bin/start_sim_novnc


# 6080 — Gazebo и RViz; 6081 — диагностика и графики.
EXPOSE 6080 6081

RUN printf '%s\n' \
    'set +u' \
    'source /opt/ros/jazzy/setup.bash' \
    'source /opt/vo_ws/install/setup.bash' \
    'source /workspace/install/setup.bash' \
    'set -u' \
    >> /root/.bashrc

# Entrypoint поднимает Xvfb, Fluxbox, x11vnc и noVNC.
ENTRYPOINT ["/usr/local/bin/start_sim_novnc"]

# Контейнер остаётся запущенным, ROS launch автоматически не стартует.
CMD ["sleep", "infinity"]