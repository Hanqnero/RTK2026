# Образ инструментов настройки. Запускается на ноутбуке.
#
# Подключается к link_server на Raspberry Pi по TCP и не требует
# ни serial-порта, ни доступа к железу.
#
# Про окна: Qt требует графической подсистемы, а у контейнера её нет.
# На macOS для окон нужен XQuartz с разрешением сетевых клиентов, см.
# раздел "Окна из контейнера на macOS" в docs/arduino/bench.rst. Без него
# используйте ключи --text и --no-plot либо запускайте инструменты
# в локальном .venv - это проще и работает сразу.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libegl1 \
        libxkbcommon-x11-0 \
        libdbus-1-3 \
        libxcb-cursor0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-shape0 \
        libxcb-xinerama0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirement.txt /tmp/requirement.txt
RUN pip install --no-cache-dir -r /tmp/requirement.txt

WORKDIR /work

ENV PYTHONUNBUFFERED=1

CMD ["bash"]
