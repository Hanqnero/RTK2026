<?xml version="1.0"?>
<robot name="rtk2026">
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
  </joint>
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.3 0.25 0.13"/>
      </geometry>
      <material name="base_grey">
        <color rgba="0.4 0.4 0.4 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.25 0.13"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>
  <joint name="left_track_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_track_link"/>
    <origin xyz="0 0.125 0" rpy="0 0 0"/>
  </joint>
  <link name="left_track_link">
    <visual>
      <geometry>
        <cylinder radius="0.026" length="0.02"/>
      </geometry>
      <material name="track_black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>
  <joint name="right_track_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_track_link"/>
    <origin xyz="0 -0.125 0" rpy="0 0 0"/>
  </joint>
  <link name="right_track_link">
    <visual>
      <geometry>
        <cylinder radius="0.026" length="0.02"/>
      </geometry>
      <material name="track_black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.15 0 0.08" rpy="0 0 0"/>
  </joint>
  <link name="lidar_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.12 0 0.06" rpy="0 0 0"/>
  </joint>
  <link name="camera_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>
</robot>
