Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Time
  Name: Time
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Alpha: 0.5
    Cell Size: 1
    Color: 160; 160; 164
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Alpha: 0.7
    Color Scheme: map
    Draw Behind: true
    Use Timestamp: false
    Topic:
      Value: /map
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Update Topic:
      Value: /map_updates
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Map
    Name: Global Costmap
    Enabled: true
    Alpha: 0.45
    Color Scheme: costmap
    Draw Behind: false
    Use Timestamp: false
    Topic:
      Value: /global_costmap/costmap
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Update Topic:
      Value: /global_costmap/costmap_updates
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Map
    Name: Local Costmap
    Enabled: true
    Alpha: 0.6
    Color Scheme: costmap
    Draw Behind: false
    Use Timestamp: false
    Topic:
      Value: /local_costmap/costmap
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Update Topic:
      Value: /local_costmap/costmap_updates
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/MarkerArray
    Name: Road Graph
    Enabled: true
    Namespaces: {}
    Topic:
      Value: /city_nav/graph
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Path
    Name: Leg Poses
    Enabled: true
    Alpha: 1.0
    Color: 0; 255; 0
    Line Style: Lines
    Line Width: 0.04
    Buffer Length: 1
    Offset:
      X: 0.0
      Y: 0.0
      Z: 0.0
    Pose Style: None
    Topic:
      Value: /city_nav/leg_path
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Path
    Name: Global Plan
    Enabled: true
    Alpha: 1.0
    Color: 255; 255; 0
    Line Style: Lines
    Line Width: 0.02
    Buffer Length: 1
    Offset:
      X: 0.0
      Y: 0.0
      Z: 0.0
    Pose Style: None
    Topic:
      Value: /plan
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Path
    Name: Local Plan
    Enabled: true
    Alpha: 1.0
    Color: 0; 255; 255
    Line Style: Lines
    Line Width: 0.02
    Buffer Length: 1
    Offset:
      X: 0.0
      Y: 0.0
      Z: 0.0
    Pose Style: None
    Topic:
      Value: /local_plan
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Polygon
    Name: Footprint
    Enabled: true
    Alpha: 1.0
    Color: 255; 128; 0
    Topic:
      Value: /local_costmap/published_footprint
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/LaserScan
    Name: Laser Scan
    Enabled: true
    Color: 255; 0; 0
    Size (Pixels): 3
    Style: Points
    Topic:
      Value: /scan
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/Image
    Name: Camera
    Enabled: true
    Normalize Range: true
    Topic:
      Value: /camera/color/image_raw
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/RobotModel
    Name: Robot Model
    Enabled: true
    Alpha: 1
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: AMCL Pose
    Enabled: true
    Topic:
      Value: /amcl_pose
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Frame Timeout: 15
    Marker Scale: 0.2
    Show Arrows: true
    Show Axes: true
    Show Names: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Value: /clicked_point
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.0685
    Topic:
      Value: /initialpose
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Angle: 0.0
      Scale: 160.0
      Target Frame: map
      X: 0.0
      Y: 1.6
      Invert Z Axis: false
    Saved: null
Views:
  Current:
    Class: rviz_default_plugins/TopDownOrtho
    Name: Current View
    Target Frame: map
    Angle: -1.5708
    Scale: 80
    X: 0
    Y: 0
Window Geometry:
  Height: 900
  Width: 1600
  X: 0
  Y: 0
