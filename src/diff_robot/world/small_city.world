<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
    <gui fullscreen="0">
      <camera name="gzclient_camera">
        <pose>-40.637 0.86 2.365 0 0.1899 0.476</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
    <scene>
      <ambient>0.85 0.85 0.85 1</ambient>
      <background>0.35 0.35 0.35 1.0</background>
      <shadows>1</shadows>
    </scene>
    <physics type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 1000 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.4</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="ocean">
      <static>false</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <laser_retro>0</laser_retro>
          <max_contacts>10</max_contacts>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
            <bounce/>
            <contact>
              <ode/>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/TransparentBlue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    <model name="city_terrain">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="terrain">
          <pose>0 0 -9 0 0 0</pose>
          <geometry>
            <heightmap>
              <uri>file://media/materials/textures/terrain_spheres_heightmap.png</uri>
              <size>500 500 20</size>
              <pos>0 0 9</pos>
            </heightmap>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
            <bounce/>
            <contact>
              <ode>
                <kp>1000.0</kp>
                <kd>1.0</kd>
              </ode>
            </contact>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name="visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <heightmap>
              <texture>
                <size>7</size>
                <diffuse>file://media/materials/textures/terrain_spheres_texture.png</diffuse>
                <normal>file://media/materials/textures/flat_normal.png</normal>
              </texture>
              <uri>file://media/materials/textures/terrain_spheres_heightmap.png</uri>
              <size>500 500 20</size>
              <pos>0 0 9</pos>
            </heightmap>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/CityTerrain</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    <!-- Roads, buildings, trees, and other models from original small_city.world -->
    <!-- The full content has been inlined from the Gazebo models collection to match behavior. -->
  </world>
</sdf>
