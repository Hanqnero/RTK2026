<?xml version="1.0"?>

<robot
  name="rtk2026_tracked"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Официальная геометрия и nominal extrinsics Intel RealSense D435i. -->
  <xacro:include
    filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro"/>

  <!--
    Это описание нужно robot_state_publisher и RViz.
    Контактная физика гусениц и сенсоры описаны в models/.../model.sdf.

    Система координат повторяет текущую колёсную модель:
      base_footprint находится на земле под осью привода;
      центр корпуса смещён на 60 мм назад и на 80 мм вверх.
  -->
  <xacro:property name="base_length" value="0.300"/>
  <!--
    Полный поперечный габарит равен 240 мм:
      корпус 180 мм;
      две гусеницы по 30 мм;
      средние плоскости гусениц разнесены на 210 мм.
  -->
  <xacro:property name="base_width" value="0.180"/>
  <xacro:property name="base_height" value="0.113"/>
  <xacro:property name="base_x" value="-0.060"/>
  <xacro:property name="base_z" value="0.080"/>

  <xacro:property name="track_separation" value="0.213"/>
  <xacro:property name="track_width" value="0.033"/>
  <xacro:property name="track_radius" value="0.060"/>
  <xacro:property name="track_end_x" value="0.120"/>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual name="base_visual">
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="gray">
        <color rgba="0.45 0.48 0.52 1"/>
      </material>
    </visual>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="${base_x} 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <!--
    В RViz гусеница показана тремя простыми элементами.
    Физический SDF использует те же размеры и положения.
  -->
  <xacro:macro name="track_link" params="side y">
    <link name="${side}_track">
      <visual name="center_visual">
        <origin xyz="0 0 -0.020" rpy="0 0 0"/>
        <geometry>
          <box size="0.240 ${track_width} 0.080"/>
        </geometry>
        <material name="${side}_track_black">
          <color rgba="0.04 0.04 0.04 1"/>
        </material>
      </visual>

      <visual name="front_visual">
        <origin xyz="${track_end_x} 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${track_radius}" length="${track_width}"/>
        </geometry>
        <material name="${side}_track_black"/>
      </visual>

      <visual name="rear_visual">
        <origin xyz="${-track_end_x} 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${track_radius}" length="${track_width}"/>
        </geometry>
        <material name="${side}_track_black"/>
      </visual>
    </link>

    <joint name="${side}_track_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${side}_track"/>
      <origin
        xyz="0 ${y} ${track_radius - base_z}"
        rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:track_link
    side="left"
    y="${track_separation / 2.0}"/>

  <xacro:track_link
    side="right"
    y="${-track_separation / 2.0}"/>

  <!-- IMU расположен по центру на внутренней стороне днища. -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${-base_height / 2.0 + 0.005}" rpy="0 0 0"/>
  </joint>

  <!-- Лидар расположен сверху в геометрическом центре корпуса. -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.040"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${base_height / 2.0 + 0.020}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_frame"/>
  <joint name="lidar_frame_joint" type="fixed">
    <parent link="lidar_link"/>
    <child link="lidar_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!--
    Нижнее резьбовое крепление D435i находится по центру передней грани.
    Геометрия, color/depth/infra frames и frames встроенной IMU создаются
    официальным realsense2_description.
  -->
  <xacro:sensor_d435i
    parent="base_link"
    name="camera"
    use_nominal_extrinsics="true">
    <origin xyz="${base_length / 2.0} 0 -0.0125" rpy="0 0 0"/>
  </xacro:sensor_d435i>

</robot>
