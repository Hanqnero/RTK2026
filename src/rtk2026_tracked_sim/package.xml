<?xml version="1.0"?>

<package format="3">
  <name>rtk2026_tracked_sim</name>
  <version>0.1.0</version>

  <description>
    Separate Gazebo tracked model of RTK2026 with the project sensor and ROS interfaces.
  </description>

  <maintainer email="kamilisxakof@gmail.com">
    maintainer
  </maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <!-- Официальные mesh и TF/extrinsics Intel RealSense D435i. -->
  <exec_depend>realsense2_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
