<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rtk2026_nav2</name>
  <version>0.1.0</version>

  <description>
    Стек Nav2 RTK2026: настройка, дерево поведения для прохода по цепочке
    поз и запуск. По присланным позам ездит сам Nav2 действием
    navigate_through_poses, поэтому своей ноды-исполнителя пакет не
    содержит. Кто присылает позы, пакету неизвестно и не нужно.
  </description>

  <maintainer email="kamilisxakof@gmail.com">RTK2026</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_common</exec_depend>

  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <!-- Плагины, названные в config/nav2_params.yaml. -->
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
