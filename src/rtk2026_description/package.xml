<?xml version="1.0"?>
<package format="3">
  <name>rtk2026_description</name>
  <version>0.1.0</version>
  <description>Fixed real-robot Xacro description plus an independent differential-drive Gazebo test model for RTK2026.</description>
  <maintainer email="kamilisxakof@gmail.com">maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend> <!-- Пакет собирается через ament_cmake -->

  <exec_depend>xacro</exec_depend> <!-- Xacro нужен для разворачивания .xacro в обычный URDF -->
  <exec_depend>robot_state_publisher</exec_depend> <!-- robot_state_publisher публикует TF-дерево робота
на основании robot_description -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
 <!-- Указываем тип системы сборки. -->
  <export><build_type>ament_cmake</build_type></export>
</package>
