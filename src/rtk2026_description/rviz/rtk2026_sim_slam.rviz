Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description: RTK2026 URDF
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Topic:
        Value: /odom
        Depth: 5
      Keep: 500
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Shape: Arrow
      Color: 255; 25; 0
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Value: /map
        Depth: 5
      Color Scheme: map
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Topic:
        Value: /plan
        Depth: 5
      Color: 0; 255; 0
  Global Options:
    Fixed Frame: odom
  Value: true
