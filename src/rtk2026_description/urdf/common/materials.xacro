<?xml version="1.0"?>
<!--
  наша либа цветов
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="black"><color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="blue"><color rgba="0.00 0.00 0.80 1.0"/></material>
  <material name="green"><color rgba="0.40 0.90 0.40 1.0"/></material>
  <material name="gray"><color rgba="0.70 0.70 0.70 1.0"/></material>
  <material name="darkgray"><color rgba="0.30 0.30 0.30 1.0"/></material>
  <material name="red"><color rgba="0.80 0.00 0.00 1.0"/></material>
  <material name="white"><color rgba="1.00 1.00 1.00 1.0"/></material>
  <material name="yellow"><color rgba="0.80 0.80 0.00 1.0"/></material>
</robot>
