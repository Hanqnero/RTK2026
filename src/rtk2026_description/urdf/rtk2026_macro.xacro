<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rtk2026_macro" params="prefix:=">
    <link name="${prefix}base_footprint"/>

    <!-- Robot: 300 mm length, 250 mm width, 113 mm height. Diff-drive. -->
    <joint name="${prefix}base_footprint_joint" type="fixed">
      <parent link="${prefix}base_footprint"/>
      <child link="${prefix}base_link"/>
      <origin xyz="0 0 0.0565" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}base_link">
      <visual>
        <geometry>
          <box size="0.3 0.25 0.113"/>
        </geometry>
        <material name="base_grey">
          <color rgba="0.4 0.4 0.4 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.3 0.25 0.113"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="5.0"/>
        <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
      </inertial>
    </link>

    <joint name="${prefix}left_track_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}left_track_link"/>
      <origin xyz="0 0.125 0" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}left_track_link">
      <visual>
        <geometry>
          <cylinder radius="0.026" length="0.02"/>
        </geometry>
        <material name="track_black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
    </link>

    <joint name="${prefix}right_track_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}right_track_link"/>
      <origin xyz="0 -0.125 0" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}right_track_link">
      <visual>
        <geometry>
          <cylinder radius="0.026" length="0.02"/>
        </geometry>
        <material name="track_black"/>
      </visual>
    </link>

    <joint name="${prefix}lidar_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}lidar_link"/>
      <origin xyz="0.15 0 0.08" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}lidar_link"/>

    <joint name="${prefix}camera_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}camera_link"/>
      <origin xyz="0.12 0 0.06" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}camera_link"/>

    <joint name="${prefix}imu_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}imu_link"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}imu_link"/>
  </xacro:macro>
</robot>
