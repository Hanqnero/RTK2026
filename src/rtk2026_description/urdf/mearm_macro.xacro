<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mearm" params="parent mount_xyz:='-0.07 -0.07 0.138'">
    <material name="mearm_dark"><color rgba="0.15 0.15 0.15 1"/></material>
    <material name="mearm_orange"><color rgba="1.0 0.45 0.0 1"/></material>
    <material name="mearm_red"><color rgba="0.8 0.05 0.05 1"/></material>

    <link name="mearm_mount_link">
      <visual><geometry><box size="0.045 0.045 0.045"/></geometry><material name="mearm_dark"/></visual>
      <collision><geometry><box size="0.045 0.045 0.045"/></geometry></collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/>
      </inertial>
    </link>
    <joint name="mearm_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="mearm_mount_link"/>
      <origin xyz="${mount_xyz}" rpy="0 0 0"/>
    </joint>

    <link name="mearm_shoulder_link">
      <visual><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.025" length="0.05"/></geometry><material name="mearm_orange"/></visual>
      <collision><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.025" length="0.05"/></geometry></collision>
      <inertial>
        <origin xyz="0 0 0.025"/>
        <mass value="0.08"/>
        <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/>
      </inertial>
    </link>
    <joint name="joint_0" type="revolute">
      <parent link="mearm_mount_link"/>
      <child link="mearm_shoulder_link"/>
      <origin xyz="0 0 0.0225"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.7854" upper="0.7854" effort="2.0" velocity="1.5"/>
    </joint>

    <link name="mearm_upper_arm_link">
      <visual><origin xyz="0.06 0 0"/><geometry><box size="0.12 0.018 0.018"/></geometry><material name="mearm_orange"/></visual>
      <collision><origin xyz="0.06 0 0"/><geometry><box size="0.12 0.018 0.018"/></geometry></collision>
      <inertial>
        <origin xyz="0.06 0 0"/>
        <mass value="0.06"/>
        <inertia ixx="0.000004" ixy="0" ixz="0" iyy="0.000075" iyz="0" izz="0.000075"/>
      </inertial>
    </link>
    <joint name="joint_1" type="revolute">
      <parent link="mearm_shoulder_link"/>
      <child link="mearm_upper_arm_link"/>
      <origin xyz="0 0 0.05"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.5708" upper="0.9948" effort="2.0" velocity="1.5"/>
    </joint>

    <link name="mearm_forearm_link">
      <visual><origin xyz="0.055 0 0"/><geometry><box size="0.11 0.016 0.016"/></geometry><material name="mearm_orange"/></visual>
      <collision><origin xyz="0.055 0 0"/><geometry><box size="0.11 0.016 0.016"/></geometry></collision>
      <inertial>
        <origin xyz="0.055 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.000003" ixy="0" ixz="0" iyy="0.000052" iyz="0" izz="0.000052"/>
      </inertial>
    </link>
    <joint name="joint_2" type="revolute">
      <parent link="mearm_upper_arm_link"/>
      <child link="mearm_forearm_link"/>
      <origin xyz="0.12 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="1.5708" effort="2.0" velocity="1.5"/>
    </joint>

    <link name="mearm_gripper_link">
      <visual><origin xyz="0.025 0 0"/><geometry><box size="0.05 0.05 0.015"/></geometry><material name="mearm_red"/></visual>
      <collision><origin xyz="0.025 0 0"/><geometry><box size="0.05 0.05 0.015"/></geometry></collision>
      <inertial>
        <origin xyz="0.025 0 0"/>
        <mass value="0.04"/>
        <inertia ixx="0.000009" ixy="0" ixz="0" iyy="0.000009" iyz="0" izz="0.000017"/>
      </inertial>
    </link>
    <joint name="joint_3" type="revolute">
      <parent link="mearm_forearm_link"/>
      <child link="mearm_gripper_link"/>
      <origin xyz="0.11 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="1.5708" effort="1.0" velocity="2.0"/>
    </joint>
  </xacro:macro>
</robot>
