<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    Небольшой мир для первичной проверки slam_toolbox.

    Внешние стены образуют помещение 8 x 6 метров. Внутренние препятствия
    специально сделаны несимметричными, чтобы лидар видел различимые признаки
    и scan matcher не путал одинаковые участки карты.
  -->
  <world name="rtk2026_slam_world">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Базовые системы Gazebo Harmonic. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Обновляет IMU sensors, добавленные к моделям роботов. -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Плоскость пола. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Северная и южная стены помещения. -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 3 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>8.2 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.2 0.2 1.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static>
      <pose>0 -3 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>8.2 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.2 0.2 1.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- Западная и восточная стены помещения. -->
    <model name="west_wall">
      <static>true</static>
      <pose>-4 0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>0.2 6.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6.2 1.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static>
      <pose>4 0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>0.2 6.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6.2 1.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- Несимметричные внутренние ориентиры для лидара. -->
    <model name="long_partition">
      <static>true</static>
      <pose>1.2 0.8 0.4 0 0 0.35</pose>
      <link name="partition_link">
        <collision name="collision"><geometry><box><size>2.2 0.18 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.18 0.8</size></box></geometry></visual>
      </link>
    </model>

    <model name="square_column">
      <static>true</static>
      <pose>-1.8 1.3 0.5 0 0 0</pose>
      <link name="column_link">
        <collision name="collision"><geometry><box><size>0.55 0.55 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 0.55 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name="round_column">
      <static>true</static>
      <pose>2.4 -1.5 0.5 0 0 0</pose>
      <link name="column_link">
        <collision name="collision"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
