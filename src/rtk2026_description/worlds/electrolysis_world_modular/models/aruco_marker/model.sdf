<?xml version="1.0"?>
<sdf version="1.9">
  <model name="aruco_marker">
    <static>true</static>

    <!--
      Единственный маркер расположен по центру внутренней стороны задней стены.
      Текстура получена из стандартного словаря OpenCV ArUco DICT_4X4_50:
      marker id=0. В модели нет collision, поэтому маркер не влияет на лидар
      и проходимость полигона.
    -->
    <link name="marker_link">
      <visual name="aruco_4x4_50_id_0">
        <pose>0 0 0.45 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box>
            <size>0.50 0.004 0.50</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://aruco_marker/materials/textures/aruco_4x4_50_id_0.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
