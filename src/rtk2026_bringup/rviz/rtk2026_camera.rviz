Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time

Visualization Manager:
  Class: ""
  Displays:
    # Обычный RGB-кадр без homography, HSV и наложения трёхмерной сцены.
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 255
      Median window: 5
      Min Value: 0
      Name: Raw Camera
      Normalize Range: false
      Queue Size: 5
      Topic:
        Value: /camera/color/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true

    # Bird's-eye публикует perspective_hsv_tuner. Это уже готовое
    # изображение, поэтому для него не требуется отдельный CameraInfo.
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 255
      Median window: 5
      Min Value: 0
      Name: Bird Eye
      Normalize Range: false
      Queue Size: 5
      Topic:
        Value: /cv/perspective/image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true

    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 255
      Median window: 5
      Min Value: 0
      Name: HSV Mask
      Normalize Range: false
      Queue Size: 5
      Topic:
        Value: /cv/perspective/hsv_mask
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: false

    - Class: rviz_default_plugins/RobotModel
      Name: Robot Model
      Enabled: true
      Alpha: 0.6
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.15
      Show Arrows: true
      Show Axes: true
      Show Names: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_footprint
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.2
      Focal Point:
        X: 0
        Y: 0
        Z: 0.08
      Name: Current View
      Pitch: 0.5
      Target Frame: base_footprint
      Value: Orbit (rviz)
      Yaw: 0.7
    Saved: ~

Window Geometry:
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1440
