Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Robot Model1
        - /Laser Scan1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true

    # Модель берётся из топика, а не из файла: описание публикует
    # robot_state_publisher на роботе, и RViz получает его даже при
    # позднем подключении - топик латчится (Transient Local).
    - Class: rviz_default_plugins/RobotModel
      Name: Robot Model
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true

    # Самый дорогой дисплей в этом наборе, поэтому он ужат.
    #
    # Рендер здесь программный, и при Update Interval: 0 с подписями
    # фреймов RViz съедал больше двух третей ядра: интерфейс отвечал
    # с задержкой, и это выглядело как "окно не кликается". Подписи
    # рисуются текстом на каждый фрейм и стоят дороже самих осей,
    # поэтому выключены; включи вручную, когда надо разобрать дерево.
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.3
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Update Interval: 0.5
      Value: true

    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.7
      Color Scheme: map
      Topic:
        Value: /map
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true

    # Скан с лидара C1: 10 Гц, дальность до 16 м.
    - Class: rviz_default_plugins/LaserScan
      Name: Laser Scan
      Enabled: true
      Alpha: 1
      Color: 255; 60; 60
      Color Transformer: FlatColor
      Size (m): 0.02
      Style: Points
      Decay Time: 0
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true

    # Выход EKF, а не сырая одометрия колёс: именно он публикует
    # odom -> base_footprint и учитывает курс с BMI270.
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Covariance:
        Value: false
      Keep: 100
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Shape:
        Alpha: 1
        Color: 60; 200; 60
        Head Length: 0.05
        Head Radius: 0.03
        Shaft Length: 0.1
        Shaft Radius: 0.01
        Value: Arrow
      Topic:
        Value: /odometry/filtered
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    # map, а не odom: при картографировании интересно видеть дрейф
    # odom относительно карты, а с фиксацией на odom он не заметен.
    Fixed Frame: map
    # 10 кадров в секунду: картинка на программном рендере всё равно не
    # идёт быстрее, а освободившееся время достаётся обработке ввода.
    Frame Rate: 10
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.0
      Yaw: 3.14
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  # Меньше экрана Xvfb (1600x900) намеренно, и с явной позицией.
  #
  # При размере ровно в экран рамка fluxbox не помещается, окно уезжает
  # за левый край вместе с заголовком, и ухватить его мышью нельзя:
  # выглядит как "RViz не реагирует на клики", хотя ввод исправен.
  X: 0
  Y: 0
  Width: 1560
  Height: 830
  Hide Left Dock: false
  Hide Right Dock: true
