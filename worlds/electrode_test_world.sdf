<?xml version="1.0"?>
<sdf version="1.9">
  <world name="electrode_test_world">

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!--
      Базовые системы Gazebo Harmonic.

      Sensors обновляет рендерящие датчики, включая GPU lidar, а Imu —
      IMU-сенсор робота. Без этих двух систем ROS-мосты /scan и /imu/data
      создаются, но сообщения из мира в них не поступают.
    -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>0 0 0</magnetic_field>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.92 0.92 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <model name="cell_base">
      <static>true</static>
      <pose>0 0 0.0400 0 0 0</pose>
      <link name="link">
      <collision name="collision">
        <geometry>
          <box><size>2.2 1.2 0.08</size></box>
        </geometry>
      </collision>
        <visual name="visual">
          <geometry>
            <box><size>2.2 1.2 0.08</size></box>
          </geometry>
          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Верх бортиков должен находиться выше плоскости сканирования лидара.

      Платформа заканчивается на z=0.08 м, а оптический центр лидара
      установлен примерно на z=0.24 м. Поэтому бортики начинаются от
      платформы и заканчиваются на z=0.38 м.
    -->
    <model name="border_front">
      <static>true</static>
      <pose>0.0000 -0.6250 0.2300 0 0 0</pose>
      <link name="link">
      <collision name="collision">
        <geometry>
          <box><size>2.3000 0.0500 0.3000</size></box>
        </geometry>
      </collision>
        <visual name="visual">
          <geometry>
            <box><size>2.3000 0.0500 0.3000</size></box>
          </geometry>
          <material>
            <ambient>0.18 0.18 0.18 1</ambient>
            <diffuse>0.18 0.18 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

