<?xml version="1.0" ?>
<!-- Полигон 5x5 ячеек по 800 мм (всего 4000x4000 мм). Периметр — стены.
     Кластер 2x2, центры постаментов (1.2,1.2)…(2.8,2.8) м, шаг 1.6 м:
     зазор между кромками постаментов (0.8x0.8) и до стен мира ~0.8 м.
     Здание до 500x500 мм; тело 400 мм + парапет 50 мм над постаментом. Координаты в метрах, Z вверх. -->
<sdf version="1.6">
  <world name="polygon_5x5_cells">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Начальный вид: позиция над (2,2), default камера смотрит +X; pitch +pi/2 вокруг Y -> взгляд вдоль -Z (строго сверху). -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>2.0 2.0 12.0 0.0 1.570796327 0.0</pose>
      </camera>
    </gui>
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.85 0.88 0.92 1</background>
      <shadows>true</shadows>
    </scene>
    <gravity>0 0 -9.81</gravity>

    <light name="sun" type="directional">
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== Периметр: квадрат 4.0 x 4.0 м, толщина стены 0.05 м, высота 1.0 м ========== -->
    <model name="wall_south">
      <static>true</static>
      <pose>2 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>4.05 0.05 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>4.05 0.05 1.0</size></box></geometry>
          <material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static>
      <pose>2 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>4.05 0.05 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>4.05 0.05 1.0</size></box></geometry>
          <material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>0 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.05 4.05 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.05 4.05 1.0</size></box></geometry>
          <material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>4 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.05 4.05 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.05 4.05 1.0</size></box></geometry>
          <material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Шаг центров 1.6 м: постаменты 0.8 м дают зазор 0.8 м -->
    <!-- Постамент 0.8 x 0.8 x 0.08, центр Z = 0.04 -->
    <!-- Здание 0.5 x 0.5 x 0.4, низ на z=0.08, центр z = 0.28 -->
    <!-- Парапет 0.5 x 0.5 x 0.05, низ на z=0.48, центр z = 0.505 -->

    <model name="pedestal_sw">
      <static>true</static>
      <pose>1.2 1.2 0.04 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 0.8 0.08</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.8 0.8 0.08</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="sign_mounts_sw">
      <static>true</static>
      <pose>1.2 1.2 0 0 0 0</pose>
      <link name="link">
        <collision name="south_left_col"><pose>-0.2 -0.39 0.155 0 0 0</pose><geometry><box><size>0.02 0.02 0.15</size></box></geometry></collision>
        <collision name="south_right_col"><pose>0.2 -0.39 0.155 0 0 0</pose><geometry><box><size>0.02 0.02 0.15</size></box></geometry></collision>
