        <visual name="west_bottom_vis"><pose>-0.39 -0.2 0.155 0 0 0</pose><geometry><box><size>0.02 0.02 0.15</size></box></geometry><material><ambient>0.32 0.32 0.34 1</ambient><diffuse>0.46 0.46 0.5 1</diffuse></material></visual>
        <visual name="west_top_vis"><pose>-0.39 0.2 0.155 0 0 0</pose><geometry><box><size>0.02 0.02 0.15</size></box></geometry><material><ambient>0.32 0.32 0.34 1</ambient><diffuse>0.46 0.46 0.5 1</diffuse></material></visual>
        <visual name="east_bottom_vis"><pose>0.39 -0.2 0.155 0 0 0</pose><geometry><box><size>0.02 0.02 0.15</size></box></geometry><material><ambient>0.32 0.32 0.34 1</ambient><diffuse>0.46 0.46 0.5 1</diffuse></material></visual>
