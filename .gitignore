# ROS / colcon build artifacts
build/
install/
log/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
docs/_build/

# Local runtime dumps
src/rtk2026_route_nav/config/local_planner_points_v3_dump.json
docker/config/local_planner_points_v3_dump.json

# OS / editor noise
.DS_Store

# Файл поз и память о знаках: их пишет прогон, версии им не нужны.
runtime/*
!runtime/.gitkeep

# Данные прогонов стенда и полевых заездов: базы RTAB-Map, логи экспериментов,
# записанные карты. Объём измеряется гигабайтами, версии им не нужны.
# Ноутбуки исследования - код, поэтому остаются под версией.
records/*
!records/*.ipynb

# Тулчейн arduino-cli ставится локально, в репозиторий не входит.
arduino/arduino-cli_*/

# Временные файлы редактора графа.
*.tmp
