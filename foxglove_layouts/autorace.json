      "smooth": false,
      "flipHorizontal": false,
      "flipVertical": false,
      "rotation": 0,
      "minValue": 0,
      "maxValue": 10000
    },
    "ImageView!white": {
      "cameraTopic": "/detect/image_output_sub1",
      "synchronize": false,
      "smooth": false,
      "flipHorizontal": false,
      "flipVertical": false,
      "rotation": 0,
      "minValue": 0,
      "maxValue": 10000
    },
    "ImageView!yellow": {
      "cameraTopic": "/detect/image_output_sub2",
      "synchronize": false,
      "smooth": false,
      "flipHorizontal": false,
      "flipVertical": false,
      "rotation": 0,
      "minValue": 0,
      "maxValue": 10000
    },
    "RawMessages!sign": {
      "topicPath": "/detect/traffic_sign"
    },
    "Plot!lane_offset": {
      "paths": [
        {
          "value": "/detect/lane.data",
          "enabled": true,
          "timestampMethod": "receiveTime"
