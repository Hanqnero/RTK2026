      "maxYValue": 1,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": false,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 15
    },
    "RawMessages!cmd_vel": {
      "topicPath": "/cmd_vel"
    }
