  "layout": {
    "first": {
      "first": {
        "first": "ImageView!lane_out",
        "second": "ImageView!ipm",
        "direction": "row",
        "splitPercentage": 50
      },
      "second": {
        "first": "ImageView!white",
        "second": "ImageView!yellow",
        "direction": "row",
        "splitPercentage": 50
      },
      "direction": "column",
      "splitPercentage": 50
    },
    "second": {
      "first": {
        "first": "Plot!lane_offset",
        "second": "RawMessages!sign",
        "direction": "column",
        "splitPercentage": 60
      },
      "second": "RawMessages!cmd_vel",
      "direction": "column",
      "splitPercentage": 70
    },
    "direction": "row",
    "splitPercentage": 70
